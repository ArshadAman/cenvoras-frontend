{
  "rewrites": [
    {
      "source": "/hsn/:match*",
      "destination": "https://api.cenvora.co.in/hsn/:match*"
    },
    {
      "source": "/gst-rate/:match*",
      "destination": "https://api.cenvora.co.in/gst-rate/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
